[importlinter]
root_package = f8pystudio

[importlinter:contract:bridge-service-liveliness-boundary]
name = bridge.service_liveliness remains a pure runtime identity helper
type = forbidden
source_modules =
    f8pystudio.bridge.service_liveliness
forbidden_modules =
    f8pystudio.assets
    f8pystudio.nodegraph
    f8pystudio.ui
    f8pystudio.operators
    f8pystudio.render_nodes
    f8pystudio.app

[importlinter:contract:bridge-rungraph-deploy-evidence-boundary]
name = bridge.rungraph_deploy_evidence remains a pure deploy evidence helper
type = forbidden
source_modules =
    f8pystudio.bridge.rungraph_deploy_evidence
forbidden_modules =
    f8pystudio.assets
    f8pystudio.nodegraph
    f8pystudio.ui
    f8pystudio.operators
    f8pystudio.render_nodes
    f8pystudio.app

[importlinter:contract:bridge-service-availability-boundary]
name = bridge.service_availability remains a pure service availability helper
type = forbidden
source_modules =
    f8pystudio.bridge.service_availability
forbidden_modules =
    f8pystudio.assets
    f8pystudio.nodegraph
    f8pystudio.ui
    f8pystudio.operators
    f8pystudio.render_nodes
    f8pystudio.app
